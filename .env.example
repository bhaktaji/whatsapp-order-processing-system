# ============================================================================
# OrderBridge Multi-Tenant WhatsApp Order Capture Suite — Environment Template
# Copy this file to .env for local development. NEVER commit real secrets.
# In staging/production on Google Cloud Run, inject sensitive values via
# Google Cloud Secret Manager.
# ============================================================================

# Application Environment: development | test | staging | production
APP_ENV="development"
PORT="8000"
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"

# PostgreSQL 16 Database Connection (Cloud SQL in production, Docker db locally)
POSTGRES_USER="orderbridge"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_DEV_PASSWORD"
POSTGRES_DB="orderbridge"
DATABASE_URL="postgresql+psycopg://orderbridge:CHANGE_ME_LOCAL_DEV_PASSWORD@localhost:5432/orderbridge"

# Security & Authentication Secrets (Required in staging/production; fail-fast enforced)
JWT_SECRET="CHANGE_ME_32_CHAR_MINIMUM_JWT_SIGNING_KEY"
PHONE_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_PII_ENCRYPTION_KEY"

# Meta WhatsApp Business Cloud API Credentials
META_VERIFY_TOKEN="CHANGE_ME_META_WEBHOOK_VERIFY_TOKEN"
META_APP_SECRET="CHANGE_ME_META_APP_HMAC_SHA256_SECRET"
META_GRAPH_API_VERSION="v21.0"
META_ACCESS_TOKEN="CHANGE_ME_SYSTEM_USER_ACCESS_TOKEN"

# AI & Multimodal Provider Configuration (Server-Side Only)
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
LLM_PROVIDER="gemini"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"
GEMINI_VISION_MODEL="gemini-3.8-flash"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
DEFAULT_TENANT_MONTHLY_LLM_CAP_PAISE="500000"

# Google Cloud Platform (Optional locally; used in staging/production)
GCP_PROJECT_ID=""
GCP_REGION="asia-south1"
GCS_MEDIA_BUCKET=""
USE_GCP_SECRET_MANAGER="false"
